{
  "name": "prep-wiki-br",
  "productName": "Prep Wiki BR",
  "version": "0.1.0",
  "description": "Biblioteca de preparacao, autonomia e saude que funciona sem internet, em portugues.",
  "homepage": "https://prep.bigode.org",
  "author": {
    "name": "Prep Wiki BR",
    "email": "support@bigode.org"
  },
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "org.bigode.prep",
    "productName": "Prep Wiki BR",
    "copyright": "Prep Wiki BR - GPLv3",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "carregando.html",
      "icone/janela.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "binarios/${os}-${arch}",
        "to": "bin"
      }
    ],
    "electronLanguages": [
      "pt-BR",
      "pt-PT",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "prep-wiki-br-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Prep Wiki BR",
      "artifactName": "prep-wiki-br-${version}-windows-${arch}-instalador.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Education",
      "executableName": "prep-wiki-br",
      "synopsis": "Biblioteca offline em portugues",
      "maintainer": "Prep Wiki BR <support@bigode.org>",
      "vendor": "Prep Wiki BR",
      "artifactName": "prep-wiki-br-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Prep Wiki BR",
          "GenericName": "Biblioteca offline",
          "GenericName[pt_BR]": "Biblioteca offline",
          "GenericName[pt]": "Biblioteca offline",
          "Comment": "Biblioteca de preparacao, autonomia e saude que funciona sem internet",
          "Comment[pt_BR]": "Biblioteca de preparação, autonomia e saúde que funciona sem internet",
          "Comment[pt]": "Biblioteca de preparação, autonomia e saúde que funciona sem internet",
          "Keywords": "wikipedia;offline;kiwix;library;biblioteca;"
        }
      },
      "icon": "build/icons"
    },
    "deb": {
      "artifactName": "prep-wiki-br_${version}_${arch}.${ext}",
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64",
        "libgbm1"
      ]
    },
    "rpm": {
      "artifactName": "prep-wiki-br-${version}.${arch}.${ext}",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret",
        "alsa-lib",
        "mesa-libgbm"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "category": "public.app-category.education",
      "artifactName": "prep-wiki-br-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false
    }
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "copyright": "Prep Wiki BR - GPLv3"
}
